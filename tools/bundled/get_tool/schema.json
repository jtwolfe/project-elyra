{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Tool package name"
    },
    "which": {
      "type": "string",
      "enum": ["current", "draft", "version"],
      "description": "Default current"
    },
    "version_id": {
      "type": "string",
      "description": "Required when which=version"
    },
    "list_versions": {
      "type": "boolean",
      "description": "If true, include versions index meta only (not full bodies)"
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
