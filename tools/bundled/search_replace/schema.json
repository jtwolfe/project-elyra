{
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "File path within the sandbox workspace"
    },
    "old": {
      "type": "string",
      "description": "Non-empty substring to replace"
    },
    "new": {
      "type": "string",
      "description": "Replacement text (may be empty)"
    },
    "count": {
      "type": "integer",
      "description": "Max replacements; 0 means replace all (default: 0)",
      "minimum": 0
    }
  },
  "required": ["path", "old", "new"],
  "additionalProperties": false
}
