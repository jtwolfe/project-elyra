{
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string",
      "description": "Parent goal id (e.g. g_…)"
    },
    "title": {
      "type": "string",
      "description": "Task title (non-empty)"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "ready", "in_progress", "blocked", "done", "cancelled"],
      "description": "Initial task status (default pending); ready enqueues task_ready"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    },
    "created_in_context": {
      "type": "object",
      "description": "Optional provenance override; host usually snapshots from session user",
      "properties": {
        "user_id": { "type": "string" },
        "goes_by": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": ["goal_id", "title"],
  "additionalProperties": false
}
